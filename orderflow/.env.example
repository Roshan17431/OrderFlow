# Local-development credentials only. Replace them outside a developer workstation.
POSTGRES_DB=orderflow_auth
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow_local_password
POSTGRES_PORT=5432

PRODUCT_POSTGRES_HOST=localhost
PRODUCT_POSTGRES_PORT=5432
PRODUCT_POSTGRES_DB=orderflow_product
PRODUCT_POSTGRES_USER=orderflow_product
PRODUCT_POSTGRES_PASSWORD=orderflow_product_local_password

INVENTORY_POSTGRES_HOST=localhost
INVENTORY_POSTGRES_PORT=5432
INVENTORY_POSTGRES_DB=orderflow_inventory
INVENTORY_POSTGRES_USER=orderflow_inventory
INVENTORY_POSTGRES_PASSWORD=orderflow_inventory_local_password

ORDER_POSTGRES_HOST=localhost
ORDER_POSTGRES_PORT=5432
ORDER_POSTGRES_DB=orderflow_order
ORDER_POSTGRES_USER=orderflow_order
ORDER_POSTGRES_PASSWORD=orderflow_order_local_password

PAYMENT_POSTGRES_HOST=localhost
PAYMENT_POSTGRES_PORT=5432
PAYMENT_POSTGRES_DB=orderflow_payment
PAYMENT_POSTGRES_USER=orderflow_payment
PAYMENT_POSTGRES_PASSWORD=orderflow_payment_local_password

DELIVERY_POSTGRES_HOST=localhost
DELIVERY_POSTGRES_PORT=5432
DELIVERY_POSTGRES_DB=orderflow_delivery
DELIVERY_POSTGRES_USER=orderflow_delivery
DELIVERY_POSTGRES_PASSWORD=orderflow_delivery_local_password

NOTIFICATION_POSTGRES_HOST=localhost
NOTIFICATION_POSTGRES_PORT=5432
NOTIFICATION_POSTGRES_DB=orderflow_notification
NOTIFICATION_POSTGRES_USER=orderflow_notification
NOTIFICATION_POSTGRES_PASSWORD=orderflow_notification_local_password

OPERATIONS_POSTGRES_HOST=localhost
OPERATIONS_POSTGRES_PORT=5432
OPERATIONS_POSTGRES_DB=orderflow_operations
OPERATIONS_POSTGRES_USER=orderflow_operations
OPERATIONS_POSTGRES_PASSWORD=orderflow_operations_local_password

REDIS_PORT=6379
REDIS_PASSWORD=

KAFKA_PORT=9092
EUREKA_PORT=8761
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
PRODUCT_SERVICE_PORT=8082
CART_SERVICE_PORT=8083
INVENTORY_SERVICE_PORT=8084
ORDER_SERVICE_PORT=8085
PAYMENT_SERVICE_PORT=8086
DELIVERY_SERVICE_PORT=8087
NOTIFICATION_SERVICE_PORT=8088
OPERATIONS_SERVICE_PORT=8089
PROMETHEUS_PORT=9091
GRAFANA_PORT=3000

APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_HTTP_MAX_REQUEST_SIZE=1MB
APP_SECURITY_HSTS_ENABLED=false

# Redis-backed gateway limits. Keep enabled outside isolated local debugging.
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_NAMESPACE=orderflow:gateway:rate-limit
APP_RATE_LIMIT_LOGIN_REQUESTS=10
APP_RATE_LIMIT_LOGIN_WINDOW=1m
APP_RATE_LIMIT_REGISTER_REQUESTS=5
APP_RATE_LIMIT_REGISTER_WINDOW=1m
APP_RATE_LIMIT_REFRESH_REQUESTS=30
APP_RATE_LIMIT_REFRESH_WINDOW=1m
APP_RATE_LIMIT_ORDER_REQUESTS=20
APP_RATE_LIMIT_ORDER_WINDOW=1m
APP_RATE_LIMIT_PAYMENT_CONFIRM_REQUESTS=10
APP_RATE_LIMIT_PAYMENT_CONFIRM_WINDOW=1m
APP_RATE_LIMIT_WEBHOOK_REQUESTS=100
APP_RATE_LIMIT_WEBHOOK_WINDOW=1m

# Local Docker uses an ephemeral RSA key pair. For production, set
# APP_JWT_ALLOW_EPHEMERAL_KEYS=false and provide protected PEM resources.
APP_JWT_ISSUER=https://orderflow.local
APP_JWT_KEY_ID=orderflow-docker-local
APP_JWT_ACCESS_TOKEN_TTL=10m
APP_JWT_ALLOW_EPHEMERAL_KEYS=true
APP_JWT_PRIVATE_KEY_LOCATION=
APP_JWT_PUBLIC_KEY_LOCATION=
APP_AUTH_JWK_SET_URI=http://localhost:8081/api/auth/.well-known/jwks.json

APP_AUTH_REFRESH_TOKEN_TTL=14d
APP_AUTH_REFRESH_COOKIE_NAME=ORDERFLOW_REFRESH
APP_AUTH_REFRESH_COOKIE_SECURE=false
APP_AUTH_REFRESH_COOKIE_SAME_SITE=Strict
APP_AUTH_LOGIN_MAX_ATTEMPTS=5
APP_AUTH_LOGIN_ATTEMPT_WINDOW=15m

APP_CATALOG_DEFAULT_CURRENCY=USD
APP_CATALOG_SUPPORTED_CURRENCIES=USD,EUR,GBP,INR
APP_CATALOG_MAX_PAGE_SIZE=100
APP_CATALOG_PRODUCT_CACHE_TTL=5m
APP_CATALOG_SEARCH_CACHE_TTL=2m
APP_CATALOG_CATEGORY_CACHE_TTL=10m

APP_CART_TTL=30d
APP_CART_MAX_DISTINCT_ITEMS=100
APP_CART_MAX_QUANTITY_PER_ITEM=99
APP_PRODUCT_CLIENT_CONNECT_TIMEOUT=2s
APP_PRODUCT_CLIENT_READ_TIMEOUT=3s
APP_CART_CLIENT_CONNECT_TIMEOUT=2s
APP_CART_CLIENT_READ_TIMEOUT=3s

APP_ORDER_EVENTS_TOPIC=orderflow.order-events.v1
APP_INVENTORY_EVENTS_TOPIC=orderflow.inventory-events.v1
APP_PAYMENT_EVENTS_TOPIC=orderflow.payment-events.v1
APP_ORDER_EVENTS_DLT=orderflow.order-events.v1.DLT
APP_INVENTORY_EVENTS_DLT=orderflow.inventory-events.v1.DLT
APP_PAYMENT_EVENTS_DLT=orderflow.payment-events.v1.DLT
APP_DELIVERY_EVENTS_TOPIC=orderflow.delivery-events.v1
APP_DELIVERY_EVENTS_DLT=orderflow.delivery-events.v1.DLT
APP_NOTIFICATION_EVENTS_TOPIC=orderflow.notification-events.v1
APP_NOTIFICATION_EVENTS_DLT=orderflow.notification-events.v1.DLT

APP_DELIVERY_ASSIGNMENT_STRATEGY=LEAST_RECENTLY_ASSIGNED
APP_DELIVERY_MAX_PAGE_SIZE=100
APP_NOTIFICATION_EMAIL_PROVIDER=simulator
APP_NOTIFICATION_SMS_PROVIDER=simulator
APP_NOTIFICATION_ASYNC_CORE_POOL_SIZE=2
APP_NOTIFICATION_ASYNC_MAX_POOL_SIZE=8
APP_NOTIFICATION_ASYNC_QUEUE_CAPACITY=200
APP_NOTIFICATION_SSE_TIMEOUT=30m

APP_ORDER_PAYMENT_WINDOW=10m
APP_ORDER_MINIMUM_PAYMENT_WINDOW=5s

APP_PAYMENT_PROVIDER=simulator
APP_PAYMENT_SIMULATOR_ENABLED=true
APP_PAYMENT_SIMULATOR_ALLOW_IN_PRODUCTION=false
# Local development only. Replace through a secret manager outside local use.
APP_PAYMENT_SIMULATOR_WEBHOOK_SECRET=orderflow-local-simulator-secret-not-for-production
APP_PAYMENT_WEBHOOK_TOLERANCE=5m
APP_PAYMENT_PROVIDER_CONNECT_TIMEOUT=2s
APP_PAYMENT_PROVIDER_READ_TIMEOUT=5s
APP_PAYMENT_PROVIDER_RETRY_ATTEMPTS=2
APP_PAYMENT_PROVIDER_RETRY_WAIT=250ms

APP_INVENTORY_RESERVATION_TTL=15m
APP_INVENTORY_EXPIRATION_POLL_DELAY=30s
APP_INVENTORY_EXPIRATION_ENABLED=true
APP_INVENTORY_EXPIRATION_DELAY=30s
APP_INVENTORY_EXPIRATION_LOCK_DURATION=5m
APP_INVENTORY_EXPIRATION_BATCH_SIZE=50

APP_SCHEDULER_INSTANCE_ID=local-instance
APP_PAYMENT_RECONCILIATION_ENABLED=true
APP_PAYMENT_RECONCILIATION_DELAY=30s
APP_PAYMENT_RECONCILIATION_BATCH_SIZE=50
APP_PAYMENT_RECONCILIATION_LOCK_DURATION=5m
APP_PAYMENT_RECONCILIATION_MAX_AGE=30d
APP_DELIVERY_ASSIGNMENT_JOB_ENABLED=true
APP_DELIVERY_ASSIGNMENT_JOB_DELAY=30s
APP_DELIVERY_ASSIGNMENT_JOB_BATCH_SIZE=50
APP_DELIVERY_ASSIGNMENT_JOB_LOCK_DURATION=5m
APP_NOTIFICATION_RECONCILIATION_ENABLED=true
APP_NOTIFICATION_RECONCILIATION_DELAY=30s
APP_NOTIFICATION_RECONCILIATION_BATCH_SIZE=50
APP_NOTIFICATION_RECONCILIATION_STALE_THRESHOLD=5m
APP_NOTIFICATION_RECONCILIATION_MAX_ATTEMPTS=5
APP_NOTIFICATION_RECONCILIATION_LOCK_DURATION=5m
APP_RETENTION_PROCESSED_EVENT=90d
APP_RETENTION_PUBLISHED_OUTBOX=30d
APP_RETENTION_JOB_HISTORY=30d
APP_RETENTION_BATCH_SIZE=1000
APP_OPERATIONS_DAILY_REPORT_ENABLED=true
APP_OPERATIONS_DAILY_REPORT_CRON=0 5 0 * * *
APP_OPERATIONS_DAILY_REPORT_ZONE=UTC
APP_OPERATIONS_REPORT_MAX_CATCHUP_DAYS=7

# Local observability credentials only; override outside a developer workstation.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=orderflow-local-only

APP_OUTBOX_POLL_DELAY=500ms
APP_OUTBOX_BATCH_SIZE=50
APP_OUTBOX_MAX_ATTEMPTS=10
APP_OUTBOX_LOCK_TIMEOUT=2m
APP_OUTBOX_RETRY_BASE_DELAY=2s

APP_OAUTH2_SUCCESS_REDIRECT_URI=http://localhost:3000/oauth2/success
APP_OAUTH2_FAILURE_REDIRECT_URI=http://localhost:3000/oauth2/failure
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Disabled by default; no administrator credentials are supplied.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_DISPLAY_NAME=

# JVM defaults for local Compose. Production-like Compose uses its own settings.
ORDERFLOW_JAVA_TOOL_OPTIONS="-Xms32m -Xmx128m -XX:+UseSerialGC -XX:ActiveProcessorCount=2 -XX:TieredStopAtLevel=1 -XX:+ExitOnOutOfMemoryError"
# Native standalone registry hostname (Docker profile uses service-registry).
EUREKA_HOSTNAME=localhost

# Optional Next.js frontend Compose profile (public browser configuration only)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_OAUTH_PROVIDERS=
