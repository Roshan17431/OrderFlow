# Local-development credentials only. Replace them outside a developer workstation.
POSTGRES_DB=orderflow_auth
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow_local_password
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_PASSWORD=

KAFKA_PORT=9092
EUREKA_PORT=8761
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081

APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Local Docker uses an ephemeral RSA key pair. For production, set
# APP_JWT_ALLOW_EPHEMERAL_KEYS=false and provide protected PEM resources.
APP_JWT_ISSUER=https://orderflow.local
APP_JWT_KEY_ID=orderflow-docker-local
APP_JWT_ACCESS_TOKEN_TTL=10m
APP_JWT_ALLOW_EPHEMERAL_KEYS=true
APP_JWT_PRIVATE_KEY_LOCATION=
APP_JWT_PUBLIC_KEY_LOCATION=
APP_AUTH_JWK_SET_URI=http://localhost:8081/api/auth/.well-known/jwks.json

APP_AUTH_REFRESH_TOKEN_TTL=14d
APP_AUTH_REFRESH_COOKIE_NAME=ORDERFLOW_REFRESH
APP_AUTH_REFRESH_COOKIE_SECURE=false
APP_AUTH_REFRESH_COOKIE_SAME_SITE=Strict
APP_AUTH_LOGIN_MAX_ATTEMPTS=5
APP_AUTH_LOGIN_ATTEMPT_WINDOW=15m

APP_OAUTH2_SUCCESS_REDIRECT_URI=http://localhost:5173/oauth2/success
APP_OAUTH2_FAILURE_REDIRECT_URI=http://localhost:5173/oauth2/failure
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Disabled by default; no administrator credentials are supplied.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_DISPLAY_NAME=
