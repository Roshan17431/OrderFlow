{"uid":"orderflow-overview","title":"OrderFlow Overview","schemaVersion":41,"version":1,"refresh":"15s","panels":[{"id":1,"type":"timeseries","title":"Request rate","targets":[{"expr":"sum(rate(http_server_requests_seconds_count[5m]))"}]},{"id":2,"type":"timeseries","title":"Error rate","targets":[{"expr":"sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))"}]},{"id":3,"type":"timeseries","title":"API latency p95","targets":[{"expr":"histogram_quantile(0.95,sum by(le)(rate(http_server_requests_seconds_bucket[5m])))"}]},{"id":4,"type":"stat","title":"Outbox backlog","targets":[{"expr":"sum(orderflow_outbox_backlog)"}]},{"id":5,"type":"stat","title":"DLT events","targets":[{"expr":"sum(increase(orderflow_kafka_dlt_publications_total[1h]))"}]},{"id":6,"type":"stat","title":"Scheduled job failures","targets":[{"expr":"sum(increase(scheduler_job_failure_total[1h]))"}]},{"id":7,"type":"stat","title":"Pending delivery assignment","targets":[{"expr":"sum(deliveries_pending_assignment)"}]},{"id":8,"type":"stat","title":"Notification failures","targets":[{"expr":"sum(increase(notification_reconciliation_failed_total[1h]))"}]}]}
