{"uid":"orderflow-scheduled-jobs","title":"OrderFlow Scheduled Jobs","schemaVersion":41,"version":1,"refresh":"15s","panels":[{"id":1,"type":"timeseries","title":"Job execution rate","targets":[{"expr":"sum by(job,service)(rate(scheduler_job_runs_total[5m]))"}]},{"id":2,"type":"timeseries","title":"Job failure rate","targets":[{"expr":"sum by(job,service)(rate(scheduler_job_failure_total[5m]))"}]},{"id":3,"type":"timeseries","title":"Job duration","targets":[{"expr":"sum by(job,service)(rate(scheduler_job_duration_seconds_sum[5m])) / sum by(job,service)(rate(scheduler_job_duration_seconds_count[5m]))"}]},{"id":4,"type":"stat","title":"Skipped locks","targets":[{"expr":"sum(increase(scheduler_job_skipped_locked_total[1h]))"}]},{"id":5,"type":"stat","title":"Inventory expirations","targets":[{"expr":"sum(increase(inventory_reservation_expired_total[1h]))"}]},{"id":6,"type":"stat","title":"Payment reconciliations","targets":[{"expr":"sum(increase(payment_reconciliation_processed_total[1h]))"}]},{"id":7,"type":"stat","title":"Delivery assignments","targets":[{"expr":"sum(increase(delivery_assignment_job_assignments_total[1h]))"}]},{"id":8,"type":"stat","title":"Notification recoveries","targets":[{"expr":"sum(increase(notification_reconciliation_recovered_total[1h]))"}]}]}
