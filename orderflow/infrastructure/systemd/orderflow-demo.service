[Unit]
Description=Resume the last verified OrderFlow cloud demo release
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
RequiresMountsFor=/opt/orderflow
ConditionPathExists=/opt/orderflow/releases/state/runtime-release.json

[Service]
EnvironmentFile=-/etc/default/orderflow-demo
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/orderflow-host resume
ExecStop=/usr/local/sbin/orderflow-host stop-containers
TimeoutStartSec=1200
TimeoutStopSec=210
UMask=0077

[Install]
WantedBy=multi-user.target
