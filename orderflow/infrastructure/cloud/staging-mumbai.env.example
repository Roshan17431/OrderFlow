# MUMBAI ACCEPTANCE TEMPLATE ONLY; copy to protected /opt/orderflow/config/runtime.env, mode 0600.
# Keep ORDERFLOW_ENVIRONMENT=cloud-demo for existing safety guards.
# Use the approved hostname and stable key ID; OAuth stays disabled.
# Fill every blank; do not commit the populated file. All twelve images require ECR @sha256 digests.
ORDERFLOW_ENVIRONMENT=cloud-demo
AWS_ACCOUNT_ID=
AWS_REGION=ap-south-1
RELEASE_VERSION=
ECR_REGISTRY=
DATA_ROOT=/opt/orderflow/data
CONFIG_ROOT=/opt/orderflow/config
BACKUP_KEY_FILE=/opt/orderflow/config/backup.key
ACME_EMAIL=
APP_JWT_KEY_ID=
APP_PAYMENT_SIMULATOR_WEBHOOK_SECRET=
AUTH_POSTGRES_DB=orderflow_auth
AUTH_POSTGRES_PASSWORD=
AUTH_POSTGRES_USER=orderflow_auth
DELIVERY_POSTGRES_DB=orderflow_delivery
DELIVERY_POSTGRES_PASSWORD=
DELIVERY_POSTGRES_USER=orderflow_delivery
DOMAIN_NAME=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ADMIN_USER=
IMAGE_API_GATEWAY=
IMAGE_AUTH_SERVICE=
IMAGE_CART_SERVICE=
IMAGE_DELIVERY_SERVICE=
IMAGE_FRONTEND=
IMAGE_INVENTORY_SERVICE=
IMAGE_NOTIFICATION_SERVICE=
IMAGE_OPERATIONS_SERVICE=
IMAGE_ORDER_SERVICE=
IMAGE_PAYMENT_SERVICE=
IMAGE_PRODUCT_SERVICE=
IMAGE_SERVICE_REGISTRY=
INVENTORY_POSTGRES_DB=orderflow_inventory
INVENTORY_POSTGRES_PASSWORD=
INVENTORY_POSTGRES_USER=orderflow_inventory
KAFKA_CLUSTER_ID=
NOTIFICATION_POSTGRES_DB=orderflow_notification
NOTIFICATION_POSTGRES_PASSWORD=
NOTIFICATION_POSTGRES_USER=orderflow_notification
OPERATIONS_POSTGRES_DB=orderflow_operations
OPERATIONS_POSTGRES_PASSWORD=
OPERATIONS_POSTGRES_USER=orderflow_operations
ORDER_POSTGRES_DB=orderflow_order
ORDER_POSTGRES_PASSWORD=
ORDER_POSTGRES_USER=orderflow_order
PAYMENT_POSTGRES_DB=orderflow_payment
PAYMENT_POSTGRES_PASSWORD=
PAYMENT_POSTGRES_USER=orderflow_payment
POSTGRES_PASSWORD=
POSTGRES_USER=orderflow_admin
PRODUCT_POSTGRES_DB=orderflow_product
PRODUCT_POSTGRES_PASSWORD=
PRODUCT_POSTGRES_USER=orderflow_product
REDIS_PASSWORD=
# OAuth is opt-in: configure both actual registered callbacks and credentials.
# AUTH_SPRING_PROFILES_ACTIVE=docker,cloud-demo,oauth2
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
